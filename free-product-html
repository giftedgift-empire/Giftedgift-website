    }

    footer {
      padding: 28px 16px;
      text-align: center;
      background: #123a8c;
      color: white;
      line-height: 1.8;
    }

    footer a {
      color: #f2bd16;
      text-decoration: none;
      font-weight: 700;
    }

    @media (max-width: 760px) {

      .hero-grid {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 31px;
      }

      .cover-box {
        min-height: 280px;
      }

    }

  </style>

</head>


