<script
  src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"
></script>


<script>

  /*
  ==================================================
  SUPABASE
  ==================================================
  */

  const SUPABASE_URL =
    "https://mvoxizdzjmtcvokowhpd.supabase.co";


  const SUPABASE_PUBLISHABLE_KEY =
    "sb_publishable_5wjUjC6amD7e2H_3h_7UQw_TY6orH16";


  const supabaseClient =
    supabase.createClient(
      SUPABASE_URL,
      SUPABASE_PUBLISHABLE_KEY
    );


  /*
  ==================================================
  STATE
  ==================================================
  */

  let currentProduct =
    null;

  let currentDownloadToken =
    null;


  /*
  ==================================================
  SLUG

  Supports:
  /free-product.html?slug=my-book
  /free-product?slug=my-book
  /free/my-book
  ==================================================
  */

  function getSlug() {

    const params =
      new URLSearchParams(
        window.location.search
      );


    const querySlug =
      String(
        params.get("slug") || ""
      ).trim();


    if (querySlug) {
      return querySlug;
    }


    const pathParts =
      window.location.pathname
        .split("/")
        .filter(Boolean);


    const freeIndex =
      pathParts.indexOf("free");


    if (
      freeIndex >= 0 &&
      pathParts[
        freeIndex + 1
      ]
    ) {

      return decodeURIComponent(
        pathParts[
          freeIndex + 1
        ]
      ).trim();

    }


    return "";

  }


  /*
  ==================================================
  MESSAGE HELPERS
  ==================================================
  */

  function showMessage(
    id,
    text,
    type
  ) {

    const box =
      document.getElementById(
        id
      );


    box.className =
      "message " +
      type;


    box.textContent =
      text;

  }


  function clearMessage(
    id
  ) {

    const box =
      document.getElementById(
        id
      );


    box.className =
      "message";


    box.textContent =
      "";

  }


  /*
  ==================================================
  EDGE FUNCTION
  ==================================================
  */

  async function invokeFunction(
    functionName,
    body
  ) {

    const {
      data,
      error
    } =
      await supabaseClient
        .functions
        .invoke(
          functionName,
          {
            body
          }
        );


    if (error) {

      let message =
        error.message ||
        "The secure request failed.";


      try {

        if (
          error.context &&
          typeof error.context.json ===
            "function"
        ) {

          const details =
            await error.context.json();


          if (details?.error) {
            message =
              details.error;
          }

        }

      }

      catch (
        parseError
      ) {

        console.error(
          "Function error:",
          parseError
        );

      }


      throw new Error(
        message
      );

    }


    if (data?.error) {
      throw new Error(
        data.error
      );
    }


    return data;

  }


  /*
  ==================================================
  LOAD FREE PRODUCT
  ==================================================
  */

  async function loadProduct() {

    const slug =
      getSlug();


    if (!slug) {
      showProductError(
        "Free product link is incomplete."
      );

      return;
    }


    const {
      data,
      error
    } =
      await supabaseClient
        .rpc(
          "get_public_free_digital_product_by_slug",
          {
            p_slug:
              slug
          }
        );


    const product =
      Array.isArray(
        data
      )
        ? data[0]
        : null;


    if (
      error ||
      !product
    ) {

      console.error(
        "Free product:",
        error
      );


      showProductError(
        "This free product is unavailable."
      );

      return;
    }


    currentProduct =
      product;


    renderProduct(
      product
    );


    document
      .getElementById(
        "loading"
      )
      .style.display =
        "none";


    document
      .getElementById(
        "page-content"
      )
      .style.display =
        "block";

  }


  function renderProduct(
    product
  ) {

    document
      .getElementById(
        "product-name"
      )
      .textContent =
        product.name ||
        "Free Digital Product";


    document
      .getElementById(
        "product-description"
      )
      .textContent =
        product.description ||
        "Download this free GiftedGift Empire digital resource.";


    /*
    ================================================
    IMAGE
    ================================================
    */

    const image =
      document.getElementById(
        "product-image"
      );


    const placeholder =
      document.getElementById(
        "cover-placeholder"
      );


    if (
      product.image_url
    ) {

      image.src =
        product.image_url;


      image.alt =
        product.name ||
        "Free digital product";


      image.onload =
        () => {

          image.style.display =
            "block";


          placeholder.style.display =
            "none";

        };


      image.onerror =
        () => {

          placeholder.textContent =
            "Product cover unavailable.";

        };

    }

    else {

      placeholder.textContent =
        "Product cover unavailable.";

    }


    /*
    ================================================
    NEWSLETTER REQUIREMENT
    ================================================
    */

    const requiresNewsletter =
      product
        .requires_newsletter_subscription ===
      true;


    const consentArea =
      document.getElementById(
        "consent-area"
      );


    const consentCheckbox =
      document.getElementById(
        "newsletter-consent"
      );


    const button =
      document.getElementById(
        "subscribe-button"
      );


    const benefitBox =
      document.getElementById(
        "benefit-box"
      );


    if (
      requiresNewsletter
    ) {

      consentArea.style.display =
        "flex";


      consentCheckbox.required =
        true;


      button.textContent =
        "SUBSCRIBE & GET FREE PRODUCT";


      benefitBox.textContent =
        "Subscribe to GiftedGift Empire and your free download will be unlocked immediately.";

    }

    else {

      consentArea.style.display =
        "none";


      consentCheckbox.required =
        false;


      button.textContent =
        "GET FREE PRODUCT";


      benefitBox.textContent =
        "Enter your details below and your free download will be unlocked immediately.";

    }


    /*
    ================================================
    SEO
    ================================================
    */

    document.title =
      (product.name ||
        "Free Digital Product") +
      " | GiftedGift Empire";


    const metaDescription =
      document.getElementById(
        "meta-description"
      );


    metaDescription.content =
      String(
        product.description ||
        "Get this free digital product from GiftedGift Empire."
      )
        .replace(/\s+/g, " ")
        .trim()
        .slice(
          0,
          155
        );


    const canonical =
      document.getElementById(
        "canonical-link"
      );


    canonical.href =
      "https://giftedgiftempire.com/free/" +
      encodeURIComponent(
        product.slug
      );

  }


  function showProductError(
    message
  ) {

    document
      .getElementById(
        "loading"
      )
      .style.display =
        "none";


    const errorBox =
      document.getElementById(
        "error-box"
      );


    errorBox.textContent =
      message;


    errorBox.style.display =
      "block";

  }


  /*
  ==================================================
  SUBSCRIBE + UNLOCK
  ==================================================
  */

  async function subscribeAndUnlock(
    event
  ) {

    event.preventDefault();


    clearMessage(
      "form-message"
    );


    if (
      !currentProduct
    ) {

      showMessage(
        "form-message",
        "This free product could not be loaded.",
        "error"
      );

      return;
    }


    const name =
      document
        .getElementById(
          "subscriber-name"
        )
        .value
        .trim();


    const email =
      document
        .getElementById(
          "subscriber-email"
        )
        .value
        .trim();


    const consent =
      document
        .getElementById(
          "newsletter-consent"
        )
        .checked;


    const website =
      document
        .getElementById(
          "website"
        )
        .value
        .trim();


    if (
      name.length < 2
    ) {

      showMessage(
        "form-message",
        "Please enter your name.",
        "error"
      );

      return;
    }


    if (!email) {

      showMessage(
        "form-message",
        "Please enter your email address.",
        "error"
      );

      return;
    }


    if (
      currentProduct
        .requires_newsletter_subscription ===
        true &&
      !consent
    ) {

      showMessage(
        "form-message",
        "Please agree to subscribe to the newsletter to receive this free product.",
        "error"
      );

      return;
    }


    const button =
      document.getElementById(
        "subscribe-button"
      );


    button.disabled =
      true;


    button.textContent =
      "PREPARING YOUR FREE PRODUCT...";


    showMessage(
      "form-message",
      "Please wait while we prepare your free download...",
      "info"
    );


    try {

      const result =
        await invokeFunction(
          "free-product-subscribe",
          {

            slug:
              currentProduct.slug,

            name:
              name,

            email:
              email,

            consent:
              consent,

            website:
              website

          }
        );


      if (
        !result?.download_token
      ) {

        throw new Error(
          "Secure download access was not returned."
        );

      }


      currentDownloadToken =
        result.download_token;


      document
        .getElementById(
          "subscription-area"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "success-box"
        )
        .style.display =
          "block";


      document
        .getElementById(
          "success-message"
        )
        .textContent =
          result.message ||
          "Your free product is ready.";


      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    }

    catch (
      error
    ) {

      console.error(
        "Free product unlock:",
        error
      );


      showMessage(
        "form-message",
        error.message ||
        "Your free product could not be prepared.",
        "error"
      );

    }

    finally {

      button.disabled =
        false;


      button.textContent =
        currentProduct
          ?.requires_newsletter_subscription ===
        true
          ? "SUBSCRIBE & GET FREE PRODUCT"
          : "GET FREE PRODUCT";

    }

  }


  /*
  ==================================================
  SECURE DOWNLOAD
  ==================================================
  */

  async function downloadFreeProduct() {

    clearMessage(
      "download-message"
    );


    if (
      !currentDownloadToken
    ) {

      showMessage(
        "download-message",
        "Your secure download session is unavailable. Please submit the form again.",
        "error"
      );

      return;
    }


    const button =
      document.getElementById(
        "download-button"
      );


    button.disabled =
      true;


    button.textContent =
      "PREPARING SECURE DOWNLOAD...";


    showMessage(
      "download-message",
      "Preparing your private download link...",
      "info"
    );


    try {

      const result =
        await invokeFunction(
          "free-digital-download",
          {
            download_token:
              currentDownloadToken
          }
        );


      if (
        !result?.download_url
      ) {

        throw new Error(
          "Secure download link was not returned."
        );

      }


      const remaining =
        Number(
          result.downloads_remaining ??
          0
        );


      showMessage(
        "download-message",
        "Your secure download is ready. Downloads remaining: " +
          remaining +
          ".",
        "success"
      );


      window.location.assign(
        result.download_url
      );

    }

    catch (
      error
    ) {

      console.error(
        "Free download:",
        error
      );


      showMessage(
        "download-message",
        error.message ||
        "Your secure download could not be prepared.",
        "error"
      );

    }

    finally {

      button.disabled =
        false;


      button.textContent =
        "DOWNLOAD YOUR FREE PRODUCT";

    }

  }


  /*
  ==================================================
  START
  ==================================================
  */

  loadProduct();

</script>


<script
  src="cookie-consent.js"
  defer
></script>

<script
  src="tracking.js"
  defer
></script>


</body>

</html>
